{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Viewer Lite",
  "version": "1.2.0",
  "identifier": "cn.pursueray.mdviewer.lite",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MD 查看器 Lite",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 MarcusLong",
    "category": "Productivity",
    "shortDescription": "轻量 Markdown 阅读器",
    "longDescription": "轻量、纯本地的 Markdown 阅读器，支持文件夹、大纲、代码高亮与复制 Markdown/纯文本。",
    "publisher": "MarcusLong",
    "homepage": "https://github.com/2642086672/markdown-viewer",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}