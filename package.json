{
  "name": "markdown-viewer",
  "version": "1.2.0",
  "description": "轻量、纯本地、零依赖的 Markdown 阅读器，基于 Electron（Windows / macOS）",
  "main": "main.js",
  "author": {
    "name": "MarcusLong",
    "url": "https://github.com/2642086672"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2642086672/markdown-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/2642086672/markdown-viewer/issues"
  },
  "homepage": "https://github.com/2642086672/markdown-viewer#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac-x64": "electron-builder --mac --x64",
    "dist:mac-arm64": "electron-builder --mac --arm64",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:dev": "npm run tauri:prepare && tauri dev",
    "tauri:build": "npm run tauri:prepare && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cn.pursueray.mdviewer",
    "productName": "MD Viewer",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["zh-CN", "en"],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "md-viewer.html",
      "tauri-shim.js",
      "assets/icon.png"
    ],
    "artifactName": "MD-Viewer-${version}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "dmg": {
      "title": "MD Viewer ${version}",
      "format": "ULFO"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MD Viewer"
    }
  }
}